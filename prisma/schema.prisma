generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectSectionType {
  RICH_TEXT
  SINGLE_IMAGE
  IMAGE_GALLERY
  METRICS_GRID
  QUOTE
  CODE_SAMPLE
  BEFORE_AFTER
  ARCHITECTURE_DIAGRAM
  VIDEO
  TWO_COLUMN
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum AuditStrategy {
  MOBILE
  DESKTOP
}

enum AuditStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         UserRole   @default(ADMIN)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model Project {
  id                String              @id @default(cuid())
  title             String
  slug              String              @unique
  shortSummary      String
  projectType       String
  industries        String[]
  year              Int
  status            ProjectStatus       @default(DRAFT)
  displayOrder      Int                 @default(0)
  featured          Boolean             @default(false)
  liveUrl           String?
  repositoryUrl     String?
  repositoryVisible Boolean             @default(false)
  demoUrl           String?
  overview          String?
  problem           String?
  goals             String?
  role              String?
  approach          String?
  challenges        String?
  solutions         String?
  outcome           String?
  lessons           String?
  seoTitle          String?
  seoDescription    String?
  publishedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  cardImageId       String?
  coverImageId      String?
  socialImageId     String?
  cardImage         MediaAsset?         @relation("ProjectCardImage", fields: [cardImageId], references: [id], onDelete: SetNull)
  coverImage        MediaAsset?         @relation("ProjectCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)
  socialImage       MediaAsset?         @relation("ProjectSocialImage", fields: [socialImageId], references: [id], onDelete: SetNull)
  sections          ProjectSection[]
  images            ProjectImage[]
  technologies      ProjectTechnology[]
  metrics           ProjectMetric[]
  performanceAudits PerformanceAudit[]
  testimonials      Testimonial[]

  @@index([status, displayOrder])
  @@index([featured, status])
}

model ProjectSection {
  id        String             @id @default(cuid())
  projectId String
  type      ProjectSectionType
  title     String?
  content   Json
  position  Int
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, position])
  @@index([projectId])
}

model MediaAsset {
  id                String         @id @default(cuid())
  cloudinaryId      String         @unique
  kind              MediaKind      @default(IMAGE)
  fileName          String
  format            String
  mimeType          String
  bytes             Int
  width             Int?
  height            Int?
  altText           String?
  secureUrl         String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  projectImages     ProjectImage[]
  cardForProjects   Project[]      @relation("ProjectCardImage")
  coverForProjects  Project[]      @relation("ProjectCoverImage")
  socialForProjects Project[]      @relation("ProjectSocialImage")
  clientLogos       Client[]       @relation("ClientLogo")
  testimonialPhotos Testimonial[]  @relation("TestimonialPhoto")
}

model ProjectImage {
  id        String     @id @default(cuid())
  projectId String
  mediaId   String
  role      String
  position  Int        @default(0)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([projectId, mediaId, role])
  @@index([projectId, position])
}

model Technology {
  id        String              @id @default(cuid())
  name      String              @unique
  slug      String              @unique
  category  String
  icon      String?
  position  Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  projects  ProjectTechnology[]
}

model ProjectTechnology {
  projectId    String
  technologyId String
  category     String
  position     Int        @default(0)
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Restrict)

  @@id([projectId, technologyId])
  @@index([projectId, position])
}

model ProjectMetric {
  id        String  @id @default(cuid())
  projectId String
  label     String
  value     String
  unit      String?
  position  Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
}

model PerformanceAudit {
  id                  String        @id @default(cuid())
  projectId           String
  testedUrl           String
  strategy            AuditStrategy
  status              AuditStatus   @default(PENDING)
  performanceScore    Int?
  accessibilityScore  Int?
  bestPracticesScore  Int?
  seoScore            Int?
  lcpMs               Float?
  cls                 Float?
  fcpMs               Float?
  speedIndexMs        Float?
  totalBlockingTimeMs Float?
  inpMs               Float?
  lighthouseVersion   String?
  source              String        @default("Google PageSpeed Insights")
  publicVisible       Boolean       @default(false)
  failureMessage      String?
  rawSnapshot         Json?
  auditedAt           DateTime?
  createdAt           DateTime      @default(now())
  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, strategy, status, auditedAt])
}

model Client {
  id           String        @id @default(cuid())
  name         String        @unique
  websiteUrl   String?
  logoId       String?
  displayOrder Int           @default(0)
  published    Boolean       @default(false)
  logo         MediaAsset?   @relation("ClientLogo", fields: [logoId], references: [id], onDelete: SetNull)
  testimonials Testimonial[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Testimonial {
  id           String      @id @default(cuid())
  clientId     String?
  authorName   String
  authorRole   String
  quote        String
  photoId      String?
  projectId    String?
  published    Boolean     @default(false)
  featured     Boolean     @default(false)
  displayOrder Int         @default(0)
  client       Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  photo        MediaAsset? @relation("TestimonialPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  project      Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([published, displayOrder])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id        String    @id @default(cuid())
  name      String
  email     String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}
